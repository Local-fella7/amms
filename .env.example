# Application
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Browser-facing API base (what the SPA calls from the browser).
#   Local dev:  /api          -> Nitro dev server proxies /api/** to the backend
#   Production: /backend/api  -> static SPA calls the backend directly (same origin)
# ---------------------------------------------------------------------------
NUXT_PUBLIC_API_BASE=/api

# ---------------------------------------------------------------------------
# Server-side proxy target (Nitro dev/preview only). The real backend URL that
# the /api/** (or configured browser base) proxy forwards to.
# ---------------------------------------------------------------------------
NUXT_API_BASE=http://192.168.100.100/amms/public/api

# Database / Storage (if applicable)
# DATABASE_URL=

# Authentication / API Keys
# API_SECRET=123
