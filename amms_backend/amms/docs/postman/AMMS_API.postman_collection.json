{
  "info": {
    "name": "AMMS API",
    "description": "Association Membership Management System API\n\nBase URL: {{base_url}}\n\n1. Run **Auth > Login** first to obtain JWT token\n2. Token is auto-saved to collection variable `jwt_token`\n3. All protected requests use Bearer auth automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "amms-api-v1"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/amms/public/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', json.data.token);",
                  "    pm.test('Token saved', function () {",
                  "        pm.expect(json.data.token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@amms.local\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        { "name": "List Roles", "request": { "method": "GET", "url": "{{base_url}}/roles" } },
        { "name": "Get Role", "request": { "method": "GET", "url": "{{base_url}}/roles/1" } },
        { "name": "Create Role", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Role\"\n}" }, "url": "{{base_url}}/roles" } },
        { "name": "Update Role", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Role\"\n}" }, "url": "{{base_url}}/roles/1" } },
        { "name": "Delete Role", "request": { "method": "DELETE", "url": "{{base_url}}/roles/1" } }
